# Ask Pylot — required for chat
OPENAI_API_KEY=

# Models (defaults match these if omitted)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase vector store — required for persistent RAG
# Create a project at https://supabase.com then run supabase/pylot.sql
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects POST /api/pylot/ingest (pick any long random string)
PYLOT_INGEST_SECRET=
